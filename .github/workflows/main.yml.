name: Deploy Sudan Pay
on:
  push:
    branches: [ main ]

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v2

      - name: Inject Firebase Secrets
        run: |
          sed -i "s/REPLACE_WITH_API_KEY/${{ secrets.FIREBASE_API_KEY }}/g" app.js
          sed -i "s/REPLACE_WITH_AUTH_DOMAIN/${{ secrets.FIREBASE_AUTH_DOMAIN }}/g" app.js
          sed -i "s/REPLACE_WITH_PROJECT_ID/${{ secrets.FIREBASE_PROJECT_ID }}/g" app.js

      - name: Deploy to GitHub Pages
        uses: peaceiris/actions-gh-pages@v3
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./

